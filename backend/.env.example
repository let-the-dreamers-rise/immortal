# Copy to .env for local runs. Never commit real values.
MONGO_URL=mongodb://localhost:27017
DB_NAME=immortal
# Comma-separated; empty allows all origins (auth uses a bearer header, not cookies).
CORS_ORIGINS=

# RevenueCat (optional). Without the secret key, premium gates are not enforced server-side.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT_ID=pro
# Must equal the Authorization header value set on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=

# Native Google sign-in (optional): OAuth client IDs allowed as the ID token audience.
GOOGLE_CLIENT_IDS=

# Password reset emails (optional). Gmail works with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

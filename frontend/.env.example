# Copy to .env for local runs, or set these as EAS environment variables.
# EXPO_PUBLIC_* values are bundled into the app, so only public keys belong here.
EXPO_PUBLIC_BACKEND_URL=https://your-api.example.com

# RevenueCat public SDK keys (goog_... / appl_..., or a test_... Test Store key).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Google sign-in: the OAuth *web* client ID (also add it to the server's GOOGLE_CLIENT_IDS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

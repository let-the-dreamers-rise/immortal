{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://immortal-api-222482716856.us-central1.run.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://immortal-api-222482716856.us-central1.run.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
